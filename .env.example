# ─── Database: Neon Postgres ──────────────────────────────────────────
# neon.tech → your project → Connect → copy the connection string.
# Leave empty to use a local SQLite file (data/app.db) instead.
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────
# Signs login sessions. Any long random string. (If empty, one is generated
# and stored in data/.secret_key — fine locally; set it explicitly in production.)
APP_SECRET_KEY=

# Optional — enables the "Continue with Google" button.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:8000
GOOGLE_CLIENT_ID=

# ─── LLM (optional but recommended) ───────────────────────────────────
# console.groq.com → API Keys. Without it, a built-in rule-based parser is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Misc ─────────────────────────────────────────────────────────────
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# ALLOWED_ORIGINS=http://localhost:8000
